<Window x:Class="CrossConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrossConnect" Height="560" Width="700"
        MinHeight="520" MinWidth="600"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- Base button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#7C3AED"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B4B6E"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#A0A0C0"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#2D2D44"/>
            <Setter Property="Foreground"       Value="#E0E0F0"/>
            <Setter Property="CaretBrush"       Value="#E0E0F0"/>
            <Setter Property="BorderBrush"      Value="#4B4B6E"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Mode panel -->
            <RowDefinition Height="*"/>     <!-- Log -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CrossConnect"
                       Foreground="#E0E0F0"
                       FontSize="22"
                       FontWeight="Bold"/>
            <TextBlock x:Name="StatusText"
                       Text="● Not connected"
                       Foreground="#6B6B9A"
                       FontSize="12"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Mode panel ──────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#2D2D44"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>

                <!-- Mode selector buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="HostModeButton"
                            Content="🖥  Start as Host"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            Click="HostModeButton_Click"/>
                    <Button x:Name="ClientModeButton"
                            Content="🔗  Connect to Host"
                            Style="{StaticResource PrimaryButton}"
                            Background="#2563EB"
                            Click="ClientModeButton_Click"/>
                </StackPanel>

                <!-- Host panel -->
                <StackPanel x:Name="HostPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="HOST MODE"/>
                    <TextBlock x:Name="HostInfoText"
                               Foreground="#E0E0F0"
                               FontSize="13"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StopHostButton"
                                Content="Stop"
                                Style="{StaticResource DangerButton}"
                                Click="StopHostButton_Click"/>
                    </StackPanel>

                    <!-- Input forwarding (M3/M4/M5) -->
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="INPUT SHARING"
                               Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Client screen position:"
                                   Foreground="#A0A0C0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="ArrangementBox"
                                  Width="200"
                                  Background="#2D2D44"
                                  Foreground="#E0E0F0"
                                  SelectionChanged="ArrangementBox_SelectionChanged">
                            <ComboBoxItem Content="Right of this screen" IsSelected="True"/>
                            <ComboBoxItem Content="Left of this screen"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="StartForwardingButton"
                                Content="⌨  Start Sharing"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"
                                IsEnabled="False"
                                Click="StartForwardingButton_Click"/>
                        <Button x:Name="StopForwardingButton"
                                Content="Stop Sharing"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="StopForwardingButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ForwardingStatusText"
                               Text="Waiting for a client…"
                               Foreground="#A0A0C0"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Move the cursor to the client's edge of this screen to transfer control; Scroll Lock forces a switch at any time."
                               Foreground="#6B6B9A"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Client panel -->
                <StackPanel x:Name="ClientPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="CLIENT MODE"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostIpBox"
                                 Grid.Column="0"
                                 Style="{StaticResource InputBox}"
                                 Text="192.168.1."
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="Port:"
                                   Foreground="#A0A0C0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="PortBox"
                                 Grid.Column="2"
                                 Style="{StaticResource InputBox}"
                                 Text="55400"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectButton"
                                Content="Connect"
                                Style="{StaticResource PrimaryButton}"
                                Background="#2563EB"
                                Margin="0,0,12,0"
                                Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton"
                                Content="Disconnect"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="DisconnectButton_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Connection log ──────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#2D2D44"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="CONNECTION LOG"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1"
                              x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               Foreground="#C0C0E0"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
